    "@plasmohq/messaging": "0.7.1",
    "@plasmohq/storage": "^1.15.0",
    "axios": "^1.11.0",
    "clean-css": "^5.3.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.2.0",
