    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "mantine-datatable": "^8.2.0",
    "mellowtel": "^1.6.3",
    "pdf-lib": "^1.17.1",
    "plasmo": "0.90.5",
